# Frontend
VITE_API_BASE_URL=http://127.0.0.1:5000

# Backend database
DATABASE_URL=postgresql://string_conundrum_app:PASSWORD@127.0.0.1:5432/string_conundrum

# Lecturer dashboard access. Comma-separated; any account signing in with one
# of these addresses is promoted to role='admin' on its next request. This is
# the bootstrap -- once one lecturer exists they can promote colleagues from
# the dashboard itself. See docs/admin-dashboard.md.
ADMIN_EMAILS=

# Firebase placeholders
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
